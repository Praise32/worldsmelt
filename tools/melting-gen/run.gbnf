# JSON compatto della run: 5 piani, 3 oggetti per piano, 1-3 operazioni script,
# 1 tipo di colpo per piano (step C).
# Ordine delle chiavi FISSO, identico a RunToJson() in gen_manifest.c.
root ::= "{\"floors\":[" floor "," floor "," floor "," floor "," floor "]}"

floor ::= "{\"theme\":" name ",\"style\":" name ",\"boss\":" name ",\"bg\":" color ",\"floor\":" color ",\"wall\":" color ",\"accent\":" color ",\"accent2\":" color ",\"enemy\":" color ",\"bossColor\":" color ",\"shot\":" shot ",\"shotItem\":" itemidx ",\"enemies\":[" foe "," foe "],\"bossType\":" foe ",\"room\":" room ",\"items\":[" item "," item "," item "]}"

# Tipo di nemico (fase 3b): lo INVENTA il modello, come i tipi di colpo. Il motore
# non ha un catalogo di nemici, ha solo questo vocabolario (src/core/enemy_type.h).
foe ::= "{\"name\":" name ",\"form\":" foeform ",\"move\":" foemove ",\"fire\":" foefire ",\"hp\":" mul ",\"speed\":" mul ",\"size\":" mul ",\"rate\":" mul ",\"pellets\":" knob08 "}"
foeform ::= "\"blob\"" | "\"spiky\"" | "\"armored\"" | "\"floater\""
foemove ::= "\"chase\"" | "\"kite\"" | "\"orbit\"" | "\"zigzag\"" | "\"charge\""
foefire ::= "\"none\"" | "\"single\"" | "\"spread\"" | "\"ring\""
knob08 ::= "1" | "2" | "3" | "4" | "5" | "6" | "7" | "8"

# Layout della stanza (fase 3c): lo INVENTA il modello. Il motore garantisce la
# giocabilita' (RoomLayoutBuild), qui basta forma + densita' + nome.
room ::= "{\"name\":" name ",\"form\":" roomform ",\"density\":" mul "}"
roomform ::= "\"open\"" | "\"pillars\"" | "\"corridor\"" | "\"arena\"" | "\"scatter\""

# Tipo di colpo del piano (step C): il modello lo INVENTA -- nome, forma e sette
# manopole. Il motore non ha un elenco di tipi possibili, ha solo questo
# vocabolario (vedi src/core/shot_type.h). I moltiplicatori sono relativi al
# colpo base del giocatore; il C li clampa e ribilancia comunque
# (ShotTypeBalance), quindi nessun numero qui dentro puo' rompere il gioco.
shot ::= "{\"name\":" name ",\"form\":" shotform ",\"speed\":" mul ",\"damage\":" mul ",\"size\":" mul ",\"life\":" mul ",\"pierce\":" knob03 ",\"chain\":" knob03 ",\"pellets\":" itemidx "}"
shotform ::= "\"orb\"" | "\"spike\"" | "\"beam\"" | "\"arc\"" | "\"blade\""
# Moltiplicatore: 0.x oppure 1.x/2.x (le bande vere le impone il C, qui basta
# tenere la forma numerica pulita: niente zeri iniziali, al massimo 2 decimali).
# 0..3: la vita di un nemico (fase 3b) arriva a 3.0, i moltiplicatori dei tipi di
# colpo a 2.5. Le bande VERE le impongono il C (ShotTypeClamp/EnemyTypeClamp): qui
# basta tenere la forma numerica pulita (niente zeri iniziali, al massimo 2 decimali).
mul ::= ("0" | "1" | "2" | "3") ("." [0-9] [0-9]?)?
knob03 ::= "0" | "1" | "2" | "3"
itemidx ::= "1" | "2" | "3"

item ::= "{\"name\":" name ",\"slot\":" slot ",\"traits\":[" trait ("," trait)? "],\"color\":" color ",\"script\":[" op ("," op)? ("," op)? "]}"

op ::= "{\"trigger\":" trigger ",\"op\":" opkind ",\"a\":" num ",\"b\":" num ",\"trait\":" optrait "}"

name ::= "\"" namechar{3,40} "\""
namechar ::= [A-Za-z0-9 .,'!-]
color ::= "\"#" hexd hexd hexd hexd hexd hexd "\""
hexd ::= [0-9a-fA-F]
slot ::= "\"hat\"" | "\"eyes\"" | "\"hand\"" | "\"back\"" | "\"body\"" | "\"aura\""
trait ::= "\"bounce\"" | "\"homing\"" | "\"explode\"" | "\"split\"" | "\"pierce\"" | "\"rapid\"" | "\"giant\"" | "\"slow\"" | "\"vamp\""
trigger ::= "\"on_fire\"" | "\"on_hit\""
opkind ::= "\"burst\"" | "\"projectile\"" | "\"area\"" | "\"heal\""
optrait ::= trait | "\"none\""
# La parte intera e' o "0" da solo, o una cifra 1-9 seguita da 0-2 cifre in
# piu': cosi' non si possono produrre zeri iniziali tipo "007", non validi in
# JSON.
num ::= ("0" | [1-9] [0-9]? [0-9]?) ("." [0-9] [0-9]?)?

# Build C/C++
bin/
build/
out/
*.exe
*.o
*.obj
*.dll
*.a
*.lib
*.pdb

# Contenuti generati e log
generated/
logs/

# Catalogo persistente v1 (M7, DEC-015/041/045/069): dati del giocatore,
# un file per run scritto da src/content/run_catalog.c -- mai versionato,
# stessa regola di generated/ sopra.
catalog/

# RunBundle v1 (scripts/bundle-export.sh/-import.sh): tar.gz esportati e la
# cartella di lavoro temporanea usata durante l'import (.import-tmp.*).
bundles/

# Modelli e cache locali
models/
deps/
cache/
node_modules/

# Dataset grezzo di terzi (pack CC0 scaricati): non si versiona, la
# provenienza vive in docs/ai-production/dataset/ledger.jsonl (vedi docs/ai-production/dataset/README.md).
dataset-raw/

# Dataset derivato per il QLoRA (scripts/corpus_to_dataset.py): rigenerabile
# in ogni momento dal corpus in logs/gen-corpus/, non e' sorgente.
dataset/

# Segreti e configurazioni locali
.env
.env.*
!.env.example

# File degli editor e del sistema operativo
.vscode/
.idea/
*.user
*.suo
.DS_Store
Thumbs.db

# Il grafo viene rigenerato localmente da codebase-memory-mcp.
.codebase-memory/

# Display virtuale per i test
.xvfb-runtime/
